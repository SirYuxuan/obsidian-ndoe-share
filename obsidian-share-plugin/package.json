{
  "name": "yx-md-share",
  "version": "0.1.0",
  "description": "Obsidian plugin to share notes with a floating share button",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": ["obsidian", "plugin", "share", "notes"],
  "author": "Sir丶雨轩 <https://oofo.cc>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SirYuxuan/obsidian-ndoe-share"
  },
  "homepage": "https://github.com/SirYuxuan/obsidian-ndoe-share",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "5.29.0",
    "@typescript-eslint/parser": "5.29.0",
    "builtin-modules": "3.3.0",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  },
  "dependencies": {}
}
